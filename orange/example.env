# Copy to .env on orange (gitignored). Read by portfolio-jobs; compose also takes
# PORTFOLIO_PRIVATE_USER and the Schwab app's values from it for portfolio-private (the
# Alpaca keys don't reach that container).
PORTFOLIO_PRIVATE_USER=<your Tailscale login, e.g. you@example.com>
ALPACA_API_KEY_ID=<alpaca key id>
ALPACA_API_SECRET_KEY=<alpaca secret key>
# The Schwab app (developer.schwab.com): its callback URL is the private site's
# https://<orange's tailnet name>/schwab/callback
SCHWAB_CLIENT_ID=<schwab app key>
SCHWAB_CLIENT_SECRET=<schwab app secret>
SCHWAB_CALLBACK_URL=https://<orange's tailnet name>/schwab/callback
