# Rebuilds MOTIS with fresh GTFS feeds and swaps it in (refresh-motis.sh).
# Paths assume thinkbox's checkout at /home/nick/clubhouse-server. Install:
#   sudo cp systemd/motis-refresh.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now motis-refresh.timer
# Run now: sudo systemctl start motis-refresh   Logs: journalctl -u motis-refresh
[Unit]
Description=Refresh MOTIS timetables (fresh GTFS, re-import, swap in)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=nick
WorkingDirectory=/home/nick/clubhouse-server/thinkbox
Environment=PATH=/home/nick/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/nick/clubhouse-server/thinkbox/refresh-motis.sh
TimeoutStartSec=6h
Nice=10
